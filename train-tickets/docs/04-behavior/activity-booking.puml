@startuml activity-booking
title Раванди интихоби ҷой, банди 15-дақиқагӣ ва хариди чипта (Activity Diagram)

|Мусофир|
start
:Ҷустуҷӯи қатора (истгоҳи аввал, охир ва сана);

|Веб-система|
:Намоиши қатнавҳои мувофиқ ва вагонҳо;

|Мусофир|
:Интихоби вагон (купе/плацкарт);
:Интихоби ҷой дар нақшаи интерактивӣ;

|Веб-система|
:Санҷиши ҳолати ҷой дар МБДД;
if (Ҷой холӣ аст ё мӯҳлати банди пешина гузаштааст?) then (ҳа)
    :status = 'reserved';
    :reserved_until = NOW() + 15 дақиқа;
    :Фаъолсозии таймери 15-дақиқагӣ;
    
    |Мусофир|
    repeat
        :Пур кардани маълумоти мусофир\n(ФИО, рақами шиноснома);
    repeat while (Маълумот нодуруст ё холӣ аст?) is (ҳа) not (не)
    
    :Пахши тугмаи «Пардохт кардан»;
    
    |Веб-система|
    if (Мӯҳлати 15 дақиқа ба охир нарасидааст?) then (ҳа)
        |Шлюзи пардохт / Касса|
        :Анҷоми амалиёти пардохт;
        
        |Веб-система|
        :status = 'sold';
        :Тавлиди сабт дар ҷадвали tickets;
        :Ташаккули чиптаи электронӣ бо QR-код;
        :Генерацияи файли PDF;
        
        |Мусофир|
        :Боргирии чипта дар формати PDF ва чоп;
    else (не, 15 дақиқа гузашт)
        |Веб-система|
        :Худкор озод кардани ҷой (status = 'available');
        :reserved_until = NULL;
        
        |Мусофир|
        :Огоҳӣ: «Вақти банд тамом шуд, ҷой озод гардид»;
    endif
else (не, ҷой банд ё фурӯхта шудааст)
    |Мусофир|
    :Хатогӣ: «Ин ҷой аллакай банд аст, дигар ҷойро интихоб кунед»;
endif

|Мусофир|
stop

@enduml
