@startuml
left to right direction
actor "Мусофир" as P
actor "Кассир" as C
actor "Администратор" as A
rectangle "Системаи фурӯши чипта" {
  usecase "Бақайдгирӣ / Вуруд" as UC1
  usecase "Ҷустуҷӯи рейс" as UC2
  usecase "Интихоби ҷой" as UC3
  usecase "Брон" as UC4
  usecase "Пардохт" as UC5
  usecase "Бекор кардани чипта" as UC6
  usecase "Фурӯш дар касса" as UC7
  usecase "Идоракунии рейсҳо" as UC8
  usecase "Ҳисобот" as UC9
}
P --> UC1
P --> UC2
P --> UC4
P --> UC6
UC4 .> UC3 : <<include>>
UC4 .> UC5 : <<include>>
C --> UC7
C --> UC2
A --> UC8
A --> UC9
@enduml
