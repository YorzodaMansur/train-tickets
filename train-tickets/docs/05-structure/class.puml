
@startuml class

title Railway Tickets - Диаграммаи синфҳо (Class Diagram)

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

' =========================================
' 1. DOMAIN MODEL - МОДЕЛИ ДОМЕНӢ
' =========================================

package "Модели доменӣ (Domain Model)" {

    class Station <<entity>> {
        +id: int
        +code: string
        +nameTj: string
        +nameRu: string
        +city: string
    }

    class Route <<entity>> {
        +id: int
        +code: string
        +name: string
        +originStationId: int
        +destinationStationId: int
        +distanceKm: float
        +estimatedMinutes: int
    }

    class Trip <<entity>> {
        +id: int
        +trainNumber: string
        +routeId: int
        +departureTime: datetime
        +arrivalTime: datetime
        +status: TripStatus
        +basePrice: decimal
        +getDuration(): string
    }

    class Car <<entity>> {
        +id: int
        +tripId: int
        +carNumber: int
        +carType: CarType
        +totalSeats: int
        +priceModifier: float
        +calculatePrice(basePrice: decimal): decimal
    }

    class Seat <<entity>> {
        +id: int
        +carId: int
        +seatNumber: int
        +seatType: SeatType
        +status: SeatStatus
        +isAvailable(): bool
    }

    class SeatReservation <<entity>> {
        +id: int
        +userId: int
        +tripId: int
        +seatId: int
        +reservedAt: datetime
        +expiresAt: datetime
        +status: ReservationStatus
        +isExpired(): bool
        +release(): bool
    }

    class Ticket <<entity>> {
        +id: int
        +ticketNumber: string
        +tripId: int
        +carId: int
        +seatId: int
        +userId: ?int
        +passengerName: string
        +passengerDoc: string
        +price: decimal
        +status: TicketStatus
        +purchaseChannel: string
        +paidAt: ?datetime
        +isRefundable(): bool
    }

    class User <<entity>> {
        +id: int
        +username: string
        -passwordHash: string
        +fullName: string
        +email: string
        +phone: string
        +role: Role
        +isActive: bool
    }

    class Payment <<entity>> {
        +id: int
        +ticketId: int
        +amount: decimal
        +paymentMethod: PaymentMethod
        +transactionId: string
        +paymentDate: datetime
        +status: PaymentStatus
    }

    enum Role {
        passenger
        cashier
        admin
    }

    enum CarType {
        coupe
        platzkart
        lux
        seating
    }

    enum SeatType {
        standard
        upper
        lower
        side
    }

    enum SeatStatus {
        available
        reserved
        sold
    }

    enum TripStatus {
        scheduled
        departed
        arrived
        cancelled
    }

    enum ReservationStatus {
        active
        expired
        confirmed
        cancelled
    }

    enum TicketStatus {
        booked
        paid
        refunded
        cancelled
    }

    enum PaymentMethod {
        cash
        card
        online
    }

    enum PaymentStatus {
        pending
        completed
        failed
        refunded
    }
}

' =========================================
' 2. DOMAIN RELATIONSHIPS - АЛОҚАҲО
' =========================================

' Истгоҳи оғоз ва анҷом
Route "0..*" --> "1" Station : истгоҳи оғоз
Route "0..*" --> "1" Station : истгоҳи анҷом

' Хатсайр ва қатнов
Route "1" <-- "0..*" Trip : қатновҳо

' Қатнов ва вагонҳо
Trip "1" *-- "1..*" Car : вагонҳо

' Вагон ва ҷойҳо
Car "1" *-- "1..*" Seat : ҷойҳо

' Истифодабаранда ва бандкунии ҷой
User "1" <-- "0..*" SeatReservation : банд мекунад

' Қатнов ва бандкунӣ
Trip "1" <-- "0..*" SeatReservation : қатнов

' Ҷой ва бандкунӣ
Seat "1" <-- "0..*" SeatReservation : ҷой

' Истифодабаранда ва чипта
User "0..1" <-- "0..*" Ticket : харидор

' Қатнов ва чипта
Trip "1" <-- "0..*" Ticket : чиптаҳо

' Вагон ва чипта
Car "1" <-- "0..*" Ticket : вагон

' Ҷой ва чипта
Seat "1" <-- "0..*" Ticket : ҷойи интихобшуда

' Чипта ва пардохт
Ticket "1" <-- "0..*" Payment : пардохтҳо

' Enum dependencies
User ..> Role
Car ..> CarType
Seat ..> SeatType
Seat ..> SeatStatus
Trip ..> TripStatus
SeatReservation ..> ReservationStatus
Ticket ..> TicketStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus

' =========================================
' 3. APPLICATION MODEL - СИНФҲОИ ЗАМИМА
' =========================================

package "Синфҳои замима (src/)" {

    class BookingController <<Controller>> {
        -seatRepo: SeatRepository
        -ticketRepo: TicketRepository
        -tripRepo: TripRepository
        -auth: Auth
        +search(): void
        +seatMap(tripId: int, carId: int): void
        +hold(tripId: int, seatId: int): void
        +checkout(): void
        +processPayment(): void
        +viewTicket(ticketId: int): void
        +cancelTicket(ticketId: int): void
    }

    class SeatRepository <<Repository>> {
        -db: Database
        +getByCar(carId: int): array
        +lockSeatTemporary(seatId: int, userId: int, minutes: int): bool
        +releaseExpiredLocks(): int
        +confirmPurchase(seatId: int, userId: int): bool
    }

    class TripRepository <<Repository>> {
        -db: Database
        +searchTrips(from: int, to: int, date: string): array
        +findById(id: int): ?array
        +getAvailableSeats(tripId: int): array
    }

    class TicketRepository <<Repository>> {
        -db: Database
        +createTicket(data: array): int
        +findById(id: int): ?array
        +findByNumber(number: string): ?array
        +refundTicket(ticketId: int, cashierId: int): bool
        +getSalesReport(startDate: string, endDate: string): array
    }

    class PaymentRepository <<Repository>> {
        -db: Database
        +createPayment(data: array): int
        +findByTicketId(ticketId: int): array
        +updateStatus(id: int, status: string): bool
    }

    class Database <<Database>> {
        -pdo: PDO
        +getConnection(): PDO
        +query(sql: string, params: array): PDOStatement
    }

    class Auth <<Service>> {
        +user(): ?array
        +id(): ?int
        +hasRole(role: string): bool
        +check(): bool
    }

    class PaymentService <<Service>> {
        -paymentRepo: PaymentRepository
        +processPayment(ticketId: int): bool
        +refundPayment(ticketId: int): bool
    }

    class ReservationService <<Service>> {
        -seatRepo: SeatRepository
        +reserveSeat(seatId: int, userId: int): bool
        +checkExpiration(): int
        +releaseSeat(seatId: int): bool
    }
}

' =========================================
' 4. APPLICATION RELATIONSHIPS
' =========================================

BookingController --> SeatRepository
BookingController --> TicketRepository
BookingController --> TripRepository
BookingController --> PaymentService
BookingController --> ReservationService
BookingController --> Auth

SeatRepository --> Database
TripRepository --> Database
TicketRepository --> Database
PaymentRepository --> Database

PaymentService --> PaymentRepository
ReservationService --> SeatRepository

BookingController ..> Ticket : идоракунии чипта
BookingController ..> Seat : интихоби ҷой
BookingController ..> Trip : ҷустуҷӯи қатнов

SeatRepository ..> SeatReservation : бандкунии муваққатӣ
TicketRepository ..> Ticket : сохтани чипта
PaymentRepository ..> Payment : сабти пардохт

note right of SeatReservation
  Муҳлати бандкунӣ: 15 дақиқа.

  Агар пардохт анҷом нашавад:
  1. Бандкунӣ бекор мешавад.
  2. Ҷой озод мегардад.
  3. Ҷой барои дигар мусофир
     дастрас мешавад.
end note

@enduml
